<Window x:Class="TransfertPhotos.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transfert Photos — Smartphone vers PC" Height="660" Width="800"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0" Header="1. Smartphone (branché par USB)" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Content="Actualiser" Width="100" Height="28"
                        Click="Refresh_Click" Margin="8,0,0,0"/>
                <ComboBox x:Name="DeviceBox" DisplayMemberPath="Name" Height="28"/>
            </DockPanel>
        </GroupBox>

        <GroupBox Grid.Row="1" Header="2. Dossier de destination sur le PC" Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Parcourir..." Width="100" Height="28"
                        Click="Browse_Click" Margin="8,0,0,0"/>
                <TextBox x:Name="DestBox" Height="28" VerticalContentAlignment="Center"/>
            </DockPanel>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="DateCheck" Content="Organiser par date (AAAA-MM-JJ)" IsChecked="True"
                      VerticalContentAlignment="Center" Margin="0,0,24,0"/>
            <CheckBox x:Name="SkipDupCheck" Content="Ignorer les doublons déjà copiés" IsChecked="True"
                      VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="ScanBtn" Content="Analyser" Width="110" Height="32" Click="Scan_Click" Margin="0,0,8,0"/>
            <Button x:Name="TransferBtn" Content="Transférer" Width="110" Height="32" FontWeight="Bold"
                    Click="Transfer_Click" Margin="0,0,8,0"/>
            <Button x:Name="CancelBtn" Content="Annuler" Width="90" Height="32" IsEnabled="False"
                    Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Ouvrir le dossier" Width="120" Height="32" Click="OpenDest_Click"/>
        </StackPanel>

        <ProgressBar Grid.Row="4" x:Name="Progress" Height="6" IsIndeterminate="True"
                     Visibility="Collapsed" Margin="0,0,0,8"/>

        <TextBlock Grid.Row="5" x:Name="StatusText"
                   Text="Branchez le smartphone en USB (mode « Transfert de fichiers ») puis cliquez sur Actualiser."
                   TextWrapping="Wrap" Foreground="#555555" Margin="0,0,0,8"/>

        <ListBox Grid.Row="6" x:Name="LogList" ItemsSource="{Binding Log}"
                 FontFamily="Consolas" FontSize="12"/>
    </Grid>
</Window>
